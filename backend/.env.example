# Sao chép file này thành backend/.env rồi điền giá trị thật.
# KHÔNG commit file .env (đã có trong .gitignore).

# Profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (Supabase)
DB_URL=jdbc:postgresql://<host>:5432/postgres
DB_USERNAME=
DB_PASSWORD=

# JWT — chuỗi ngẫu nhiên tối thiểu 32 byte, ví dụ: openssl rand -base64 48
JWT_SECRET=
# Thời hạn token theo định dạng ISO-8601 (mặc định PT30M và P14D)
JWT_ACCESS_TTL=PT30M
JWT_REFRESH_TTL=P14D

# Gmail SMTP (App Password 16 ký tự)
MAIL_USERNAME=
MAIL_PASSWORD=

# Redis (OTP, refresh token, giới hạn số lần thử)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Đăng nhập bằng Google: các OAuth Client ID (web, Android, iOS) phân tách bằng dấu phẩy
GOOGLE_CLIENT_IDS=

# Tài khoản admin đầu tiên (chỉ được tạo khi hệ thống chưa có admin nào, không bao giờ ghi đè admin đã có).
# Dev: bỏ trống ADMIN_PASSWORD thì dùng mật khẩu mặc định của dev. Prod: bắt buộc, tối thiểu 8 ký tự.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@jlsp.com
ADMIN_PASSWORD=
# Quên mật khẩu admin: đặt true cùng ADMIN_PASSWORD, khởi động một lần rồi bỏ cờ đi.
ADMIN_RESET_PASSWORD=false

# CORS: các origin của web admin được gọi API, phân tách bằng dấu phẩy.
# Dev để trống = cho mọi origin. Prod bắt buộc khai báo cụ thể, không dùng "*".
CORS_ALLOWED_ORIGINS=

# Dịch vụ tách giọng (vocal-service, FastAPI)
VOCAL_SERVICE_URL=http://localhost:8000/api/v1/separate-vocal

# Chỉ để chạy test khởi động ứng dụng (BackendApplicationTests); cần DB và Redis thật.
# JLSP_INTEGRATION_TESTS=true

# Chỉ khi đo hiệu năng: ghi số truy vấn SQL và thời gian của mỗi request /api/** vào log và header
# X-Query-Count / X-Response-Time-Ms. Không bật ở môi trường thật.
# APP_DIAGNOSTICS_QUERY_COUNT=true

# Giới hạn tần suất các endpoint đăng nhập / đăng ký / OTP theo IP (mặc định bật).
# RATE_LIMIT_ENABLED=true
# Chỉ đặt true khi chạy sau reverse proxy đáng tin (dùng X-Forwarded-For làm IP thật).
# TRUST_FORWARDED_FOR=false

# Thanh toán chuyển khoản VietQR (SePay). BIN ngân hàng xem tại https://api.vietqr.io/v2/banks (ACB = 970416).
PAYMENT_BANK_BIN=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=
# Khoá tự đặt (chuỗi ngẫu nhiên dài), dán cùng giá trị vào cấu hình webhook của SePay: Authorization = Apikey <khoá>.
SEPAY_WEBHOOK_KEY=
