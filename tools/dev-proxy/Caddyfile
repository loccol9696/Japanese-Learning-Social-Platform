# Reverse proxy cho dev/demo qua ngrok: gộp REST (Spring, 8080) và Socket.IO (9092) vào MỘT cổng
# để một tunnel ngrok phục vụ được cả hai.
#
#   caddy run --config tools/dev-proxy/Caddyfile
#   ngrok http 8000 --domain=delmar-posthumeral-acrophonically.ngrok-free.dev
#
# Cài Caddy trên Windows: `winget install CaddyServer.Caddy`.

{
	admin off
}

:8000 {
	# Socket.IO (netty-socketio). Caddy tự xử lý WebSocket upgrade, không buffer.
	handle /socket.io/* {
		reverse_proxy localhost:9092
	}

	# Mọi thứ còn lại là REST API.
	handle {
		reverse_proxy localhost:8080
	}
}
