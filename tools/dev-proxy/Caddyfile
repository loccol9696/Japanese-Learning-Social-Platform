# Reverse proxy cho dev/demo qua ngrok: gộp REST (Spring, 8080), Socket.IO (9092)
# và Web Frontend (Vite, 5173) vào MỘT cổng để một tunnel ngrok phục vụ được tất cả.
#
#   caddy run --config tools/dev-proxy/Caddyfile
#   ngrok http 8000 --domain=delmar-posthumeral-acrophonically.ngrok-free.dev
#
# Cài Caddy trên Windows: `winget install CaddyServer.Caddy`.

{
	admin off
}

:8000 {
	# 1. Socket.IO (netty-socketio). Caddy tự xử lý WebSocket upgrade, không buffer.
	handle /socket.io/* {
		reverse_proxy localhost:9092
	}

	# 2. REST API & Swagger UI (Spring Boot)
	handle /api/* {
		reverse_proxy localhost:8080
	}

	handle /swagger-ui/* {
		reverse_proxy localhost:8080
	}

	handle /v3/api-docs/* {
		reverse_proxy localhost:8080
	}

	# 3. Web Frontend (React / Vite)
	handle {
		reverse_proxy localhost:5173
	}
}
